# ==========================================
# DOGFOOD Web Frontend Dockerfile (Multi-stage)
# ==========================================

# ---- Stage 1: base ----
FROM node:20-alpine AS base
WORKDIR /app

# ---- Stage 2: deps — install ALL workspace dependencies inside Docker ----
FROM base AS deps

# Copy root manifest + lockfile first (best cache layer)
COPY package.json package-lock.json ./

# Copy workspace package manifests so npm can resolve the workspace graph
COPY packages/shared/package.json ./packages/shared/
COPY apps/web/package.json ./apps/web/

# npm workspaces hoist everything to the root node_modules.
# packages/shared and apps/web do NOT get their own node_modules subdirs.
RUN npm ci --include-workspace-root \
      --workspace=@dogfood/shared \
      --workspace=@dogfood/web

# ---- Stage 3: build — compile shared then Next.js ----
FROM base AS builder

# Copy installed dependencies from deps stage (root node_modules only)
COPY --from=deps /app/node_modules ./node_modules

# Copy root package.json (needed for workspace resolution at build time)
COPY package.json ./

# Copy shared package source + manifest + tsconfig
COPY packages/shared ./packages/shared

# Copy web source + manifest + tsconfig + Next.js config
COPY apps/web ./apps/web

# Build shared package first (web depends on it)
RUN npm --workspace=@dogfood/shared run build

# Ensure public directory exists so runner COPY never fails if public is empty/absent
RUN mkdir -p /app/apps/web/public

# Disable Next.js telemetry during build
ENV NEXT_TELEMETRY_DISABLED=1

# Build Next.js (produces .next/standalone due to output: 'standalone')
RUN npm --workspace=@dogfood/web run build

# ---- Stage 4: runner — minimal production image ----
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 nextjs

# Copy Next.js standalone output (self-contained server with bundled node_modules)
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./

# Copy static assets
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static

# Copy public folder
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public

USER nextjs
EXPOSE 3000

CMD ["node", "apps/web/server.js"]
