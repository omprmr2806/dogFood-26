# ==============================================================================
# DOGFOOD Platform Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development or set variables in your deployment environment.
# DO NOT COMMIT REAL PRODUCTION SECRETS TO SOURCE CONTROL.

# Application Environment (development | test | production)
NODE_ENV=development

# Backend API Configuration
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Frontend Configuration (exposed to Next.js browser runtime via NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="DOGFOOD Platform"

# Database Configuration (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dogfood_db
DB_USER=dogfood_user
DB_PASSWORD=dogfood_password
# Standard connection string (used by backend connection pool)
DATABASE_URL=postgres://dogfood_user:dogfood_password@localhost:5432/dogfood_db

# Security & Sessions (Phase 2 preview - min 32 chars in production)
JWT_SECRET=dogfood_local_dev_secret_key_minimum_32_characters_long
SESSION_EXPIRY_SECONDS=900
REFRESH_TOKEN_EXPIRY_DAYS=7

# Request Limits
BODY_SIZE_LIMIT=100kb
